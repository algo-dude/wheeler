# Local IBKR Service configuration

# TWS/Gateway connection settings
# - 7497: TWS Paper
# - 7496: TWS Live
# - 4002: IB Gateway Paper
# - 4001: IB Gateway Live
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7496
IBKR_CLIENT_ID=1

# Database:
# Option A (recommended): omit IBKR_DATABASE_PATH and let the service auto-detect via ../data/currentdb
# Option B: set an explicit path (relative paths resolve relative to repo root)
IBKR_DATABASE_PATH=../data/wheeler.db

# Service settings
IBKR_SERVICE_HOST=0.0.0.0
IBKR_SERVICE_PORT=8081
